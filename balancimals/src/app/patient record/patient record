      font-weight: 500;
      font-size: 1em;
      margin-top: 2px;
      text-decoration: underline;
      border: none;
      box-shadow: 0 2px 8px rgba(0,0,0,0.07);
      transition: background 0.2s, color 0.2s;
      cursor: pointer;
      outline: none;
      display: inline-block;
    }
    .signout-btn:hover, .signout-btn:focus {
      color: #e6f2fb;
    }
    .profile-pic {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: #e6f2fb;
      object-fit: cover;
      border: 2px solid #fff;
      box-shadow: 0 1px 4px rgba(44,44,84,0.08);
    }
    .settings-icon {
      cursor: pointer;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
      margin-left: 4px;
    }
    .settings-img {
      width: 50px;   
      height: 10x;  
      display: block;
    }
    .settings-icon:hover {
    }
    .container {
      max-width: 1200px;
      margin: 2em auto;
      padding: 2em;
      background: #ffffff;
      border-radius: 14px;
      box-shadow: 0 2px 16px rgba(44,44,84,0.07);
    }
    .patient-info, .focus-area, .charts, .summary, .footer {
      margin-bottom: 2em;
    }
    .patient-info {
      display: flex;
      align-items: center;
      gap: 2em;
      padding: 1.5em 2em;
      background: #f9f9f9;
      border-radius: 10px;
      box-shadow: 0 1px 6px rgba(44,44,84,0.04);
    }
    .patient-info-details {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 0.7em 2em;
      align-items: center;
    }
    .patient-info-details strong {
      font-size: 1.2em;
      font-weight: 600;
    }
    .focus-area {
      display: flex;
      align-items: flex-start;
      gap: 2em;
      background: #f9f9f9;
      border-radius: 10px;
      padding: 1.5em 2em;
      box-shadow: 0 1px 6px rgba(44,44,84,0.04);
    }
    .focus-area-details {
      flex: 1;
    }
    .charts {
      background: #f9f9f9;
      border-radius: 10px;
      padding: 1.5em 2em;
      box-shadow: 0 1px 6px rgba(44,44,84,0.04);
    }
    .charts img {
      width: 100%;
      height: auto;
      border-radius: 8px;
      margin-top: 1em;
      background: #e6f2fb;
    }
    .summary {
      display: flex;
      gap: 2em;
      flex-wrap: wrap;
    }
    .summary-results {
      flex: 2;
      min-width: 320px;
      background: #f9f9f9;
      border-radius: 10px;
      padding: 1em 1.5em;
      box-shadow: 0 1px 6px rgba(44,44,84,0.04);
      margin-bottom: 1em;
    }
    .summary-results h4 {
      margin-top: 0.5em;
      margin-bottom: 0.5em;
      font-size: 1.1em;
      color: #2c2c54;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1em;
      background: #fff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 1px 4px rgba(44,44,84,0.03);
    }
    th, td {
      padding: 0.5em 0.7em;
      text-align: left;
      border: 1px solid #e0e0e0;
      font-size: 0.98em;
    }
    th {
      background: #e6f2fb;
      color: #2c2c54;
      font-weight: 600;
    }
    .footer {
      background: #2c2c54;
      color: white;
      text-align: center;
      padding: 1.5em 0 1em 0;
      font-size: 1em;
      border-radius: 0 0 14px 14px;
      margin-top: 3em;
    }
    @media (max-width: 900px) {
      .container { padding: 1em; }
      .patient-info, .focus-area, .charts { flex-direction: column; gap: 1em; padding: 1em; }
